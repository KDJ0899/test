# --- LLM (OpenAI 호환 클라이언트로 사내 모델 호출) ---
# 사내 모델 엔드포인트를 쓰더라도 OpenAI 클라이언트와 호환되는 경우 base_url만 바꿔서 사용한다.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# --- 임베딩 (RAG용) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- RAG ---
RAG_TOP_K=3

# --- Agent 루프 ---
AGENT_MAX_ITERATIONS=10

# --- Tavily 검색 (search_web 툴) ---
TAVILY_API_KEY=
