# --- LLM (OpenAI 호환 클라이언트로 사내 모델 호출) ---
# 사내 모델 엔드포인트를 쓰더라도 OpenAI 클라이언트와 호환되는 경우 base_url만 바꿔서 사용한다.
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# --- 임베딩 (RAG용) ---
EMBEDDING_MODEL=text-embedding-3-small

# --- RAG ---
RAG_TOP_K=3

# --- Agent 루프 ---
AGENT_MAX_ITERATIONS=10

# --- 스포츠 여행 Agent ---
# 승인이 필요한 툴 (JSON 배열). 승인이 필요 없으면 []로 둔다.
APPROVAL_REQUIRED_TOOLS=["save_trip_plan"]
# 상대 날짜("다음 달")의 기준일 고정 (YYYY-MM-DD). 비우면 오늘. 샘플 경기는 2026-10~11월이다.
TODAY_OVERRIDE=
# CLI 고정 thread_id (InMemorySaver가 이 id로 State를 이어 준다)
THREAD_ID=local-demo

